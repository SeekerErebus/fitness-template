<section id="contact" class="py-20 lg:py-28 bg-iron-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
      <!-- Left Column - Info -->
      <div>
        <span class="text-sm font-semibold text-flow-400 uppercase tracking-widest">Get in Touch</span>
        <h2 class="text-4xl sm:text-5xl font-black text-iron-100 mt-3 mb-6">Ready to Start?</h2>
        <p class="text-iron-400 text-lg leading-relaxed mb-8">
          Drop us a line, walk in any time during open hours, or just claim your free trial and show up.
          We'll take it from there.
        </p>

        <!-- Contact Info Cards -->
        <div class="space-y-4">
          <div class="flex items-start gap-4 p-4 rounded-xl bg-iron-800 border border-iron-700">
            <div class="w-10 h-10 rounded-lg bg-volt-500/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-volt-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-iron-200">Location</h4>
              <p class="text-sm text-iron-400 mt-0.5">742 Iron Street, Suite 100, Salt Lake City, UT 84101</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-xl bg-iron-800 border border-iron-700">
            <div class="w-10 h-10 rounded-lg bg-flow-500/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-flow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-iron-200">Phone</h4>
              <a href="tel:+18015550142" class="text-sm text-iron-400 mt-0.5 hover:text-flow-400 transition-colors">(801) 555-0142</a>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-xl bg-iron-800 border border-iron-700">
            <div class="w-10 h-10 rounded-lg bg-volt-500/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-volt-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-iron-200">Email</h4>
              <a href="mailto:hello@ironandflow.com" class="text-sm text-iron-400 mt-0.5 hover:text-volt-400 transition-colors">hello@ironandflow.com</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column - Form -->
      <div>
        <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-sm font-medium text-iron-300 mb-1.5">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-xl bg-iron-800 border border-iron-700 text-iron-100 placeholder-iron-500 focus:outline-none focus:border-volt-500 focus:ring-1 focus:ring-volt-500 transition-colors"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-iron-300 mb-1.5">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-xl bg-iron-800 border border-iron-700 text-iron-100 placeholder-iron-500 focus:outline-none focus:border-volt-500 focus:ring-1 focus:ring-volt-500 transition-colors"
                placeholder="you@email.com"
              />
            </div>
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium text-iron-300 mb-1.5">Phone (optional)</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full px-4 py-3 rounded-xl bg-iron-800 border border-iron-700 text-iron-100 placeholder-iron-500 focus:outline-none focus:border-volt-500 focus:ring-1 focus:ring-volt-500 transition-colors"
              placeholder="(801) 555-0000"
            />
          </div>

          <div>
            <label for="interest" class="block text-sm font-medium text-iron-300 mb-1.5">I'm interested in...</label>
            <select
              id="interest"
              name="interest"
              class="w-full px-4 py-3 rounded-xl bg-iron-800 border border-iron-700 text-iron-100 focus:outline-none focus:border-volt-500 focus:ring-1 focus:ring-volt-500 transition-colors"
            >
              <option value="">Select an option</option>
              <option value="free-trial">Free 7-Day Trial</option>
              <option value="membership">Membership Info</option>
              <option value="personal-training">Personal Training</option>
              <option value="group-events">Group / Corporate Events</option>
              <option value="other">Something Else</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-iron-300 mb-1.5">Message</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full px-4 py-3 rounded-xl bg-iron-800 border border-iron-700 text-iron-100 placeholder-iron-500 focus:outline-none focus:border-volt-500 focus:ring-1 focus:ring-volt-500 transition-colors resize-none"
              placeholder="Tell us about your fitness goals..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3.5 px-6 bg-volt-500 text-iron-950 font-bold rounded-xl hover:bg-volt-400 transition-all hover:shadow-lg hover:shadow-volt-500/25"
          >
            Send Message
          </button>
          <p class="text-xs text-iron-500 text-center">We'll get back to you within 24 hours.</p>
        </form>
      </div>
    </div>
  </div>
</section>
