<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-iron-950 via-iron-900 to-iron-950"></div>
  <div class="absolute inset-0 opacity-20">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-volt-500 rounded-full blur-[128px]"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-flow-500 rounded-full blur-[128px]"></div>
  </div>

  <!-- Grid Pattern Overlay -->
  <div class="absolute inset-0 opacity-5" style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 64px 64px;"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-20">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-iron-800/80 border border-iron-700 mb-8">
      <span class="w-2 h-2 rounded-full bg-volt-500 animate-pulse"></span>
      <span class="text-sm font-medium text-iron-300">Now Open in Salt Lake City</span>
    </div>

    <!-- Headline -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight leading-[0.9] mb-6">
      <span class="text-iron-100">FORGE YOUR</span>
      <br />
      <span class="bg-gradient-to-r from-volt-400 to-flow-400 bg-clip-text text-transparent">STRONGEST</span>
      <br />
      <span class="text-iron-100">SELF</span>
    </h1>

    <!-- Subtitle -->
    <p class="max-w-2xl mx-auto text-lg sm:text-xl text-iron-400 leading-relaxed mb-10">
      Where iron meets intention. 10+ class types from powerlifting to yoga,
      6 expert trainers, and a community that shows up for each other.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a
        href="#pricing"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-volt-500 text-iron-950 font-bold text-lg rounded-xl hover:bg-volt-400 transition-all hover:shadow-lg hover:shadow-volt-500/25"
      >
        Start Free Trial
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
      <a
        href="#schedule"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 border border-iron-600 text-iron-200 font-semibold text-lg rounded-xl hover:bg-iron-800 hover:border-iron-500 transition-all"
      >
        View Schedule
      </a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto">
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-black text-volt-400">10+</div>
        <div class="text-sm text-iron-500 mt-1">Class Types</div>
      </div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-black text-flow-400">6</div>
        <div class="text-sm text-iron-500 mt-1">Expert Trainers</div>
      </div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-black text-volt-400">30+</div>
        <div class="text-sm text-iron-500 mt-1">Weekly Classes</div>
      </div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-black text-flow-400">12K</div>
        <div class="text-sm text-iron-500 mt-1">Sq Ft Facility</div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-iron-500 animate-bounce hidden md:flex">
    <span class="text-xs uppercase tracking-widest">Scroll</span>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>
