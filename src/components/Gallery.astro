---
import gallery from '../data/gallery.json';
---

<section id="gallery" class="py-20 lg:py-28 bg-iron-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="text-sm font-semibold text-volt-400 uppercase tracking-widest">Our Space</span>
      <h2 class="text-4xl sm:text-5xl font-black text-iron-100 mt-3 mb-4">The Facility</h2>
      <p class="max-w-2xl mx-auto text-iron-400 text-lg">
        12,000 sq ft of purpose-built training space. Every zone designed for performance and recovery.
      </p>
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {gallery.map((photo) => (
        <div class={`group relative overflow-hidden rounded-2xl ${photo.span} aspect-video`}>
          <img
            src={photo.src}
            alt={photo.alt}
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-iron-950/0 group-hover:bg-iron-950/40 transition-colors duration-300"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-300">
            <p class="text-sm text-iron-100 font-medium">{photo.alt}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
